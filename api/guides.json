---
layout: null
permalink: /api/guides.json
---
{
  "meta": {
    "generated": "{{ site.time | date_to_xmlschema }}",
    "count": {{ site.guides.size }},
    "version": "1.0",
    "site": "{{ site.title }}",
    "url": "{{ site.url }}"
  },
  "guides": [
    {%- for guide in site.guides -%}
    {
      "id": "{{ guide.url | replace: '/guides/', '' | replace: '/', '' }}",
      "title": {{ guide.title | jsonify }},
      "slug": "{{ guide.url | replace: '/guides/', '' | replace: '/', '' }}",
      "url": "{{ site.url }}{{ guide.url }}",
      "description": {{ guide.description | jsonify }},
      "category": "{{ guide.category }}",
      "organization": {{ guide.organization | jsonify }},
      "source": {{ guide.source | jsonify }},
      "tags": {{ guide.tags | jsonify }},
      "estimated_time": "{{ guide.estimated_time }}",
      "date_published": "{{ guide.date | date_to_xmlschema }}",
      {%- if guide.image -%}
      "image": "{{ site.url }}{{ guide.image }}",
      {%- endif -%}
      "content_length": {{ guide.content | strip_html | number_of_words }}
    }{%- unless forloop.last -%},{%- endunless -%}
    {%- endfor -%}
  ]
}
